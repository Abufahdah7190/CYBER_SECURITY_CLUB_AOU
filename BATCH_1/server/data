'use strict';

const COURSE_NAMES = {
  'cyber-basics': {
    ar: 'أساسيات الأمن السيبراني',
    en: 'Introduction to Cybersecurity'
  },
  'digital-literacy': {
    ar: 'الوعي الرقمي الآمن',
    en: 'Digital Safety Awareness'
  },
  'network-defense': {
    ar: 'شبكات وحماية البيانات',
    en: 'Network Security Fundamentals'
  },
  'digital-forensics': {
    ar: 'التحقيق الجنائي الرقمي',
    en: 'Digital Forensics'
  },
  'secure-coding': {
    ar: 'حماية تطبيقات الويب وOWASP Top 10',
    en: 'Web Application Security and OWASP Top 10'
  },
  'ethical-hacking': {
    ar: 'الاختبار الاختراقي الأخلاقي',
    en: 'Ethical Hacking'
  },
  'cloud-security': {
    ar: 'أمن الحوسبة السحابية',
    en: 'Cloud Security Essentials'
  },
  'soc-analyst': {
    ar: 'تحليل التهديدات والاستخبارات الأمنية',
    en: 'Cyber Threat Intelligence and SOC Analysis'
  }
};

function courseNameFor(courseSlug, language) {
  const entry = COURSE_NAMES[courseSlug];

  if (!entry) return null;

  return language === 'en' ? entry.en : entry.ar;
}

module.exports = {
  COURSE_NAMES,
  courseNameFor
};
