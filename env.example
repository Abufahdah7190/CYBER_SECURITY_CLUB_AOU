# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا تضع .env في Git أبدًا.
# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Postgres connection string.
# Local dev (matches the sandbox this was built/tested in):
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/cyberclub
# Supabase production example (from Project Settings > Database > Connection string > URI):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Must match wherever the site is actually served from (used for CORS + email links).
FRONTEND_URL=http://localhost:3000

# Resend (https://resend.com) — free tier. Leave empty in dev to log emails
# to the console instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=AOU Cyber Security Club <onboarding@resend.dev>

# Registration is restricted to official university student emails,
# e.g. 01345678ksa@aou.edu.sa — change this if the format ever changes.
ALLOWED_EMAIL_DOMAIN=aou.edu.sa
REQUIRE_STUDENT_ID_LOCAL_PART=true
